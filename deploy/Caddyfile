# Caddy config for the PK Management web cabinet (Timeweb Cloud server).
# Installed to /etc/caddy/Caddyfile by .github/workflows/server-setup.yml.
#
# - Automatic HTTPS (Let's Encrypt) once DNS for the domain points here.
# - SPA fallback: any unknown path serves index.html (needed for path URLs).
# - Precompressed .br/.gz files are produced by the deploy workflow and served
#   as-is; small files are compressed on the fly.
# - Flutter web assets are not content-hashed, so everything revalidates
#   (ETag → 304) instead of being cached blindly; index.html is never cached.

app.pk.management {
	root * /var/www/app/current

	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	@index path / /index.html /release.json
	header @index Cache-Control "no-cache"

	@static path /main.dart.js /flutter_bootstrap.js /flutter.js /flutter_service_worker.js /version.json /manifest.json /assets/* /canvaskit/* /icons/* /*.png /*.js
	header @static Cache-Control "public, max-age=0, must-revalidate"

	@wasm path *.wasm
	header @wasm Content-Type application/wasm

	# Link previews (step 17): preview bots asking for a public profile or
	# selection get a small HTML page with Open Graph tags from the og-page
	# Edge Function; browsers keep getting the app.
	@og {
		path /p/* /s/*
		header_regexp bot User-Agent (?i)(telegrambot|whatsapp|facebookexternalhit|facebot|twitterbot|vkshare|vkontakte|slackbot|linkedinbot|discordbot|skypeuripreview|viber|pinterest|applebot|googlebot|yandexbot|bingbot|duckduckbot|embedly|quora link preview|outbrain|redditbot|mastodon|iframely|telegram)
	}
	handle @og {
		rewrite * /functions/v1/og-page?path={path}
		reverse_proxy https://dherzlobdrknoajeidbz.supabase.co {
			header_up Host dherzlobdrknoajeidbz.supabase.co
			header_up -Cookie
		}
	}

	try_files {path} /index.html

	file_server {
		precompressed br gzip
	}

	# Access log goes to journald (journalctl -u caddy); a file log under
	# /var/log/caddy failed with "permission denied" under the packaged unit.
	log
}
